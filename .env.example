# ==============================================================================
# IDScanner — Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=production
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:3233", "https://yourdomain.com"]

# Image Preprocessing & Upload Limits
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_DIMENSION=1920

# OCR Engine Configuration
OCR_DEVICE=cpu
OCR_WORKERS=4

# Confidence & Threshold Settings
HIGH_CONFIDENCE_THRESHOLD=0.85
RETRY_THRESHOLD=0.70

# Server Network Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_TIMEOUT_SECONDS=30

# Optional: Ngrok Tunneling for Local Mobile Device Testing
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
