# ==============================================================================
# IDScanner — Git Ignore Configuration
# ==============================================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node.js & Frontend Build Artifacts
node_modules/
frontend/node_modules/
sdk/node_modules/
frontend/dist/
sdk/dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secrets (Keep .env.example tracked)
.env
.env.local
.env.*.local
*.pem
*.key

# IDEs & System Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Logs & Runtime Dumps
*.log
backend/logs/*.log
*.tmp
*.bak

# Docker Artifacts
.dockerignore

# Test & Sample Images (Private / Sensitive ID documents)
test_image/
test_images/
*.jpeg
*.jpg
*.png
!frontend/public/*.png
!frontend/public/*.jpg
!frontend/public/*.jpeg
!frontend/src/assets/*.png
!frontend/src/assets/*.jpg
!frontend/src/assets/*.svg

# Binaries & Executables
*.exe
ngrok.exe

